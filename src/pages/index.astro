---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { url, MISC_ICON, CLASS_ICON, CLASS_COLOR } from "../lib/wow.js";
import { ORDER, NAME, SLUG, PICKS } from "../lib/classes.js";
const cards = [
  ["elegir", "Elegir clase", "choose", "Chamán, Brujo o Druida: qué raza de la Alianza llevar y cuál te conviene."],
  ["clases", "Guía por clase", "classes", "Las 9 clases: talentos de leveo nivel a nivel, habilidades, equipo, misiones y mazmorras."],
  ["leveo", "Preparación para el leveo", "level", "Ruta de zonas 1-60, Legacy desde cero, profesiones y todo lo que da experiencia extra."],
  ["mazmorras", "Mazmorras", "dungeon", "Niveles de Forever, cómo llegar desde la Alianza, misiones y el botín que interesa."],
  ["duelos", "Duelos a nivel máximo", "pvp", "Puntos fuertes, débiles y plan contra cada clase. Provisional hasta el lanzamiento."],
];
---
<Base title="Forever Playbook">
  <section class="hero">
    <div>
      <div class="eyebrow">WoW Forever · Alianza · leveo 1-60</div>
      <h1>Forever Playbook</h1>
      <p class="lede">Tu preparación para el lanzamiento: qué clase y raza jugar, la build de talentos para subir nivel a nivel, el equipo que merece la pena, las mazmorras de cada tramo y cómo plantear los duelos.</p>
      <div class="cta">
        <a class="chip gold" href={url("elegir")}><Icon name={MISC_ICON.choose} size={22} label="" fallback="?" /> Elegir clase</a>
        <a class="chip" href={url("leveo")}><Icon name={MISC_ICON.level} size={22} label="" fallback="" /> Plan de leveo</a>
      </div>
    </div>
    <div class="box" style="display:grid;gap:12px">
      <div class="eyebrow">Lanzamiento · jueves 5 de noviembre, 00:00</div>
      <div class="countdown" id="cd" data-target="2026-11-04T23:00:00Z">
        <div><b data-u="d">–</b><span>DÍAS</span></div>
        <div><b data-u="h">–</b><span>HORAS</span></div>
        <div><b data-u="m">–</b><span>MIN</span></div>
        <div><b data-u="s">–</b><span>SEG</span></div>
      </div>
      <p class="note">Miércoles 4 a las 15:00 hora del Pacífico = medianoche en la España peninsular (23:00 en Canarias). Sale a la vez en todo el mundo.</p>
    </div>
  </section>

  <div class="facts">
    <div class="fact"><b>NIVEL 60</b><span>Tope desde el primer día</span></div>
    <div class="fact"><b>51</b><span>Puntos de talento, uno por nivel desde el 10</span></div>
    <div class="fact"><b>0 LEGACY</b><span>Empiezas de cero; el primer punto a nivel 25</span></div>
    <div class="fact"><b>NIVEL 40</b><span>Primera montura, 100 oro</span></div>
    <div class="fact"><b>9 DIC</b><span>Abren las bandas</span></div>
  </div>

  <section class="cards" aria-label="Secciones">
    {cards.map(([p, t, ic, d]) => (
      <a class="card" href={url(p)}>
        <Icon name={MISC_ICON[ic]} size={44} label={t} class="gold" />
        <div><b>{t}</b><span>{d}</span></div>
      </a>
    ))}
  </section>

  <section class="box">
    <div class="titlerow"><h2>Las 9 clases</h2><span class="note">Resaltadas, las tres que estás pensando</span></div>
    <nav class="classpick" style="margin-top:12px" aria-label="Clases">
      {ORDER.map((o) => (
        <a href={url(`clases/${SLUG[o]}`)} style={PICKS.includes(o) ? `border-color:${CLASS_COLOR[o]}` : ""}>
          <Icon name={CLASS_ICON[o]} size={26} label={NAME[o]} /> {NAME[o]}
        </a>
      ))}
    </nav>
  </section>

  <script>
    const el = document.getElementById("cd");
    if (el) {
      const target = new Date(el.dataset.target!).getTime();
      const set = (u: string, v: number) => { const b = el.querySelector(`[data-u="${u}"]`); if (b) b.textContent = String(v).padStart(2, "0"); };
      const tick = () => {
        let s = Math.max(0, Math.floor((target - Date.now()) / 1000));
        set("d", Math.floor(s / 86400)); s %= 86400;
        set("h", Math.floor(s / 3600)); s %= 3600;
        set("m", Math.floor(s / 60)); set("s", s % 60);
      };
      tick(); setInterval(tick, 1000);
    }
  </script>
</Base>
