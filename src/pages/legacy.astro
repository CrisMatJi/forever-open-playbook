---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { DATA, CLASS_ICON, PROF_ICON, MISC_ICON, url } from "../lib/wow.js";
const { STEPS } = DATA;
const SPEND = [
  ["Well Rested", "5/5", 5, "Aventura", "Peaje para abrir Talented. Fuera de combate no hace nada en el duelo, pero sin él no llegas a lo siguiente."],
  ["Talented", "5/5", 5, "Aventura", "Empiezas a recibir talentos desde el nivel 5: 26 puntos a nivel 30 en vez de 21."],
  ["High Alert", "2/2", 2, "Utilidad", "Detectas sigilo como si fueras 2 niveles más alto: ves antes a Pícaros y Druidas."],
  ["Field Medicine", "2/2", 2, "Utilidad", "\"Vendado recientemente\" dura menos: vendas antes entre duelos."],
  ["Gourmand", "2/3", 2, "Utilidad", "La comida con estadísticas dura más."],
];
---
<Base title="Legacy" active="legacy" description="Qué hacer con los 16 puntos de Legacy que Blizzard regala en la beta de WoW Forever, para el torneo The Forever Open.">
  <div class="pagehead">
    <div class="eyebrow">Actualizado el 2 oct · Blizzard regala 16 puntos</div>
    <h1>Legacy: qué hacer con los 16 puntos</h1>
    <p class="lede">Ya no hace falta subir alters ni profesiones para conseguir Legacy. Blizzard ha anunciado que dará <b>16 puntos a todos los testers de la beta</b>, justo el máximo que se puede gastar por personaje. Esta página te dice en qué gastarlos.</p>
  </div>

  <section class="box news">
    <div class="eyebrow">Lo que se sabe</div>
    <ul class="bul" style="margin-top:8px">
      <li><b>Anunciado, aún no aplicado:</b> Kaivax (Blizzard), 1 oct: "En una semana próxima de la beta daremos 16 puntos de Legacy a todos los testers y los mantendremos hasta el final de la beta". Mira tu panel de Legacy cada semana.</li>
      <li><b>Máximo 16 por personaje.</b> Con los regalados ya llegas al tope: el Cazador y el personaje de relleno del plan anterior ya no hacen falta.</li>
      <li><b>En el torneo están permitidos</b> ("Legacy points are permitted"). La organización ha comentado que podría recortar el efecto de algunas ventajas, y se habla de Talented. Si pasa, te tocaría la build de 21 puntos.</li>
      <li><b>Si tardan en aplicarlos:</b> tu propio Chamán ya da 5 puntos (nivel 25 + Peletería e Ingeniería a 150 y 225). Con eso llegas a Well Rested 5/5, pero no a Talented.</li>
    </ul>
  </section>

  <div class="split">
    <div class="box">
      <h2>Reparto recomendado (16 puntos)</h2>
      <ul class="alloc" style="margin-top:10px">
        {SPEND.map(([n, r, , tree, why]) => <li><span class="name">{n}</span><span class="rank num">{r}</span><span class="why">{why} <span class="note">· {tree}</span></span></li>)}
      </ul>
      <p class="note" style="margin-top:8px">Total 16. Si el panel te ofrece otras ventajas útiles con los últimos puntos (por ejemplo Thrill of Adventure o Reagent Economy), compáralas: para un duelo pesan más las que actúan en combate o entre duelos.</p>
    </div>
    <div class="box">
      <h3>Calcula tus talentos</h3>
      <div class="field"><label for="lgPts">Puntos de Legacy que tienes</label><div class="row"><input type="range" id="lgPts" min="0" max="16" value="16" /><output id="oPts" class="num">16</output></div></div>
      <div class="big"><b class="num" id="lgTalents">26</b><span>puntos de talento a nivel 30<br /><span class="note" id="lgDelta"></span></span></div>
      <div class="warnline" id="lgWarn" hidden></div>
      <p class="note" style="margin-top:10px">Talented 1/5 cuesta 6 puntos (5 de Well Rested + 1) y el 5/5 cuesta 10.</p>
    </div>
  </div>

  <section class="box">
    <h2>Qué cambia en tu plan</h2>
    <div class="chars" style="margin-top:12px">
      <div class="charcard">
        <div class="role">Antes</div>
        <h3 class="racecell"><Icon name={CLASS_ICON.hunter} size={30} label="Cazador" /> 3 personajes</h3>
        <ul>
          <li>Cazador a 25 con Sastrería y Encantamiento.</li>
          <li>Personaje de relleno con Alquimia y Herrería.</li>
          <li>Todo para juntar 10 puntos.</li>
        </ul>
      </div>
      <div class="charcard">
        <div class="role">Ahora</div>
        <h3 class="racecell"><Icon name={CLASS_ICON.shaman} size={30} label="Chamán" /> Solo tu Chamán</h3>
        <ul>
          <li>Todo el tiempo para el Chamán: nivel 30, equipo y práctica de duelos.</li>
          <li>Peletería + Ingeniería siguen siendo las mejores: equipo ligado y bombas, red y Recombobulator.</li>
          <li>Primeros auxilios a 210: pociones de sanación y vendas.</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="box">
    <div class="titlerow"><h2>Calendario hasta el torneo</h2><span class="note">Marca lo que vayas cerrando (se guarda en este navegador)</span></div>
    <ol class="timeline" id="timeline">
      {STEPS.map(([w, t], i) => (
        <li><span class="when">{w}</span><label><input type="checkbox" data-i={i} /><span class="what">{t}</span></label></li>
      ))}
    </ol>
  </div>

  <div class="sources">
    <b>Fuentes:</b>
    <ul>
      <li><a href="https://us.forums.blizzard.com/en/wow/t/legacy-points-for-beta-testing/2368776" target="_blank" rel="noopener">Blizzard (Kaivax): Legacy points for beta testing</a></li>
      <li><a href="https://www.icy-veins.com/wow-forever/news/players-getting-free-legacy-points-for-testing/" target="_blank" rel="noopener">Icy Veins: free Legacy points for testing</a></li>
      <li><a href="https://classicwowforever.com/legacy/" target="_blank" rel="noopener">Classic WoW Forever: ventajas y costes de Legacy</a></li>
      <li><a href="https://foreverchanges.pro/duel-tournament" target="_blank" rel="noopener">ForeverChanges: notas del torneo</a></li>
    </ul>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    function legacy() {
      const total = +$("lgPts").value;
      $("oPts").value = String(total);
      const tal = total >= 6 ? Math.min(5, total - 5) : 0;
      $("lgTalents").textContent = String(21 + tal);
      $("lgDelta").textContent = tal ? `+${tal} sobre un personaje sin Legacy` : "igual que sin Legacy";
      const w = $("lgWarn");
      if (total < 6) { w.hidden = false; w.innerHTML = `<b>Con menos de 6 puntos no llegas a Talented.</b> Te faltan ${6 - total}.`; }
      else if (total < 10) { w.hidden = false; w.innerHTML = `Te faltan <b>${10 - total}</b> para Talented 5/5.`; }
      else w.hidden = true;
    }
    $("lgPts").addEventListener("input", legacy);
    legacy();
    let done: Record<string, boolean> = {};
    try { done = JSON.parse(localStorage.getItem("tfo-steps2") || "{}"); } catch {}
    const tl = document.getElementById("timeline")!;
    const paint = () => tl.querySelectorAll<HTMLInputElement>("input").forEach((b) => { b.checked = !!done[b.dataset.i!]; b.closest("li")!.classList.toggle("done", b.checked); });
    tl.addEventListener("change", (e) => { const t = e.target as HTMLInputElement; done[t.dataset.i!] = t.checked; try { localStorage.setItem("tfo-steps2", JSON.stringify(done)); } catch {} paint(); });
    paint();
  </script>
</Base>
