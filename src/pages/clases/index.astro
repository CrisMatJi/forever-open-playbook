---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { CLASS_ICON, CLASS_COLOR, url } from "../../lib/wow.js";
import { CLASSES, ORDER, PICKS, NAME, SLUG, RACE_ES } from "../../lib/classes.js";
const rk = (r) => { const k = r.split(" (")[0].replace("Skyborne - High Order", "Skyborne"); return RACE_ES[k] || k; };
---
<Base title="Clases" active="clases" description="Guía de leveo de las 9 clases de WoW Forever para la Alianza.">
  <div class="pagehead">
    <div class="eyebrow">Las 9 clases · Alianza</div>
    <h1>Guía por clase</h1>
    <p class="lede">Para cada clase: la mejor raza de la Alianza, los talentos de leveo nivel a nivel, las habilidades clave, el equipo que merece la pena, las misiones de clase y las mazmorras que más te rinden.</p>
  </div>
  <section class="classgrid">
    {ORDER.map((id) => {
      const d = CLASSES[id];
      return (
        <a class={`classcard ${PICKS.includes(id) ? "pick" : ""}`} href={url(`clases/${SLUG[id]}`)} style={`--cc:${CLASS_COLOR[id]}`}>
          <Icon name={CLASS_ICON[id]} size={48} label={NAME[id]} big />
          <div>
            <b>{NAME[id]}</b>
            <span class="note">Leveo: {d?.leveling?.spec || "—"}</span>
            {d?.races?.[0] && <span class="note">Raza: {d.races.filter((r) => r.verdict === "best").map((r) => rk(r.race)).join(" / ") || rk(d.races[0].race)}</span>}
            {PICKS.includes(id) && <span class="vtag q-leg">En tu lista</span>}
          </div>
        </a>
      );
    })}
  </section>
</Base>
