---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { DATA, CLASS_ICON, PROF_ICON, PROF_KEY_NAME, MISC_ICON, url } from "../lib/wow.js";
import { expand, BUILDS, getClass } from "../lib/talents.js";
const { GUIDE, MATCHUPS, route } = DATA;
import DUNGEONS from "../data/dungeons.json";
import GearTable from "../components/GearTable.astro";
const KIND = { dungeon: ["Mazmorra", "k-dun"], buy: ["Comprar", "k-buy"], gear: ["Equipo", "k-gear"], quest: ["Misión", "k-quest"] };
const VERDICT = { yes: ["Sí", "good"], maybe: ["Opcional", "warn"], no: ["No", "bad"] };
const ROLES = [["main", CLASS_ICON.shaman], ["hunter", CLASS_ICON.hunter], ["filler", PROF_ICON["Alquimia"]]].filter(([r]) => route[r]);
const seq = expand(BUILDS.shaman);
const sham = getClass("shaman");
const autoLabel = (it) =>
  it.p ? `${PROF_KEY_NAME[it.p[0]] ?? it.p[0]} ${it.p[1]}` :
  it.learn ? "profesiones aprendidas" : it.lvl ? `nivel ${it.lvl}` : it.totem ? "tótem conocido" :
  it.tools ? "herramientas en la bolsa" : it.equip ? "objeto equipado" : it.build ? "build completa" : null;
const allKeys = [
  ...GUIDE.flatMap((s) => s.items.map((_, j) => `${s.id}-${j}`)),
  ...Object.values(route).flatMap((r) => r.sections.flatMap((s) => s.items.map((_, j) => `${s.id}-${j}`))),
];
---
<Base title="Mi guía" active="guia" description="Ruta de speedrun por nivel y checklist completo del Chamán Orco Mejora para The Forever Open.">
  <div class="guidehead">
    <div class="pagehead">
      <div class="eyebrow">Tu caso · de hoy al 17 de octubre</div>
      <h1>Mi guía: Chamán Orco Mejora</h1>
      <p class="lede">Primero la <b>ruta por nivel</b>: qué subir, cuánto y con qué objetos en cada tramo. Debajo, el checklist de todo lo demás. Marca cada paso al terminarlo: se guarda en este navegador. Lo que aún no se puede comprobar en la beta va como <span class="verify">verificar</span>. Cómo jugar en cada tramo: <a href={url("gameplay")}>Mi gameplay</a>.</p>
    </div>
    <div class="progress box">
      <div class="eyebrow">Progreso total</div>
      <b class="num" id="gProgNum">0/0</b>
      <div class="bar" role="progressbar" aria-label="Progreso de la guía" aria-valuemin="0" aria-valuemax="100" id="gProgBar"><i id="gProgFill"></i></div>
      <button class="chip small" id="gReset" type="button">Desmarcar todo</button>
      <p class="note" id="gResetConfirm" hidden>¿Seguro? <button class="linkbtn" id="gResetYes" type="button">Sí, desmarcar</button> · <button class="linkbtn" id="gResetNo" type="button">No</button></p>
    </div>
  </div>

  <div class="box sync">
    <div>
      <div class="eyebrow">Sincronizar con el addon ForeverPvPTournament</div>
      <p class="note" style="margin-top:4px">En el juego escribe <code>/tfo export</code>, copia con Ctrl+C y pégalo aquí. Se marcan las casillas que el addon ha comprobado y se pone tu nivel en la ruta. Lo que marcaste aquí a mano se mantiene. ¿No lo tienes? <a href={url("addon")}>Descárgalo</a>.</p>
    </div>
    <div class="syncrow">
      <label for="gImport" class="sr-only">Código del addon</label>
      <input id="gImport" type="text" placeholder="TFO1;k=ins-0,...;lv=30;..." autocomplete="off" spellcheck="false" />
      <button class="chip" id="gImportBtn" type="button">Importar</button>
    </div>
    <p class="note" id="gImportMsg" aria-live="polite"></p>
  </div>

  <!-- RUTA POR NIVEL -->
  <section class="box" id="ruta" style="display:grid;gap:14px">
    <div class="routehead">
      <div>
        <div class="eyebrow">Speedrun · lo mismo que ves en el tracker del addon</div>
        <h2>Ruta por nivel</h2>
      </div>
      <div class="rolepick classpick" role="group" aria-label="Personaje" hidden={ROLES.length < 2}>
        {ROLES.map(([r, ic]) => (
          <button type="button" data-role={r} aria-pressed={r === "main" ? "true" : "false"}>
            <Icon name={ic} size={26} label={route[r].label} /> {route[r].label}
          </button>
        ))}
      </div>
    </div>
    <div class="lvlpick">
      <label for="lvl">Estoy a nivel</label>
      <input type="range" id="lvlRange" min="1" max="30" value="1" aria-label="Nivel" />
      <input type="number" id="lvl" min="1" max="30" value="1" />
    </div>
    <p class="note">Se abre el tramo que te toca; en rojo lo que te dejaste atrás. Las cantidades de objetos son orientativas (guías de Classic): en Forever alguna receta puede cambiar. El addon los marca solo; aquí se marcan a mano o importando el código.</p>
    {Object.entries(route).map(([r, data]) => (
      <div class="rsecs" data-route={r} hidden={r !== "main"}>
        {data.sections.map((s) => (
          <details class="rsec" data-from={s.from} data-to={s.to} data-sec={s.id}>
            <summary>
              <span class="lv">{s.from === s.to ? `Nv ${s.from}` : `Nv ${s.from}-${s.to}`}</span>
              <h3>{s.title.replace(/^Nv [\d-]+ · /, "")}</h3>
              <span class="tag" data-tag>0/{s.items.length}</span>
            </summary>
            <ul class="check">
              {s.items.map((it, j) => {
                const k = `${s.id}-${j}`;
                const a = autoLabel(it);
                const pname = it.p ? PROF_KEY_NAME[it.p[0]] : null;
                return (
                  <li>
                    <label>
                      <input type="checkbox" data-k={k} />
                      <span>
                        {pname && <span class="proftag"><Icon name={PROF_ICON[pname]} size={18} label={pname} /></span>} {it.kind && <span class={`ktag ${KIND[it.kind][1]}`}>{KIND[it.kind][0]}</span>} {it.t}
                        {(a || it.tip) && (
                          <span class="meta">
                            {a && <span class="badge auto" title="El addon lo marca solo">auto · {a}</span>}
                            {it.tip && <span class="badge tip">{it.tip}</span>}
                          </span>
                        )}
                      </span>
                    </label>
                  </li>
                );
              })}
            </ul>
          </details>
        ))}
      </div>
    ))}
  </section>

  <section class="box" id="mazmorras" style="display:grid;gap:10px">
    <div>
      <div class="eyebrow">Qué mazmorras rentan subiendo</div>
      <h2>Mazmorras hasta nivel 30</h2>
      <p class="note" style="margin-top:4px">Cada mazmorra da mucha experiencia la primera vez por sus misiones; repetirla no compensa. Niveles según ForeverChanges (beta).</p>
    </div>
    <div class="tablewrap"><table class="wide">
      <thead><tr><th>Mazmorra</th><th>Niveles</th><th>Dónde</th><th>¿Renta?</th><th>Por qué</th></tr></thead>
      <tbody>{DUNGEONS.map(([n, lv, where, v, why]) => <tr><td><b>{n}</b></td><td class="num">{lv}</td><td>{where}</td><td><span class={`pill v-${VERDICT[v][1]}`}>{VERDICT[v][0]}</span></td><td>{why}</td></tr>)}</tbody>
    </table></div>
  </section>

  <div class="summary">
    <div><span>Clase y raza</span><b>Chamán Orco</b><em>Mejora · tier A</em></div>
    <div><span>Profesiones</span><b>Desuello + Minería</b><em>→ Peletería + Ingeniería hacia el 28</em></div>
    <div><span>Secundarias</span><b>Primeros auxilios + Cocina</b><em>desde el nivel 5</em></div>
    <div><span>Talentos</span><b>26 puntos</b><em>con Talented 5/5 (10 de Legacy)</em></div>
    <div><span>Legacy</span><b>16 puntos regalados</b><em>cuando Blizzard los aplique</em></div>
    <div><span>Fechas</span><b>16 · 17 · 18 oct</b><em>build · clasificatoria · final</em></div>
  </div>

  <nav class="toc" aria-label="Pasos del checklist">
    {GUIDE.map((s, i) => <a href={`#g-${s.id}`} class="tocitem" data-sec={s.id}><span class="tocn">{i + 1}</span>{s.title}</a>)}
  </nav>

  <div style="display:grid;gap:16px">
    {GUIDE.map((s, i) => (
      <section class="gsec box" id={`g-${s.id}`}>
        <header><span class="gnum">{i + 1}</span><div><div class="eyebrow">{s.when}</div><h3>{s.title}</h3></div><span class="gcount" data-gc={s.id}></span></header>
        <ul class="check">
          {s.items.map((t, j) => <li><label><input type="checkbox" data-k={`${s.id}-${j}`} /><span set:html={t} /></label></li>)}
        </ul>
        {s.extra === "talents" && (
          <div class="gextra"><div class="eyebrow">Orden de talentos del Chamán</div>
            <p class="note" style="margin-top:4px">Sin Legacy: un punto por nivel desde el 10. Cuando gastes Talented en el 25, recibes de golpe los puntos atrasados y sigues el mismo orden.</p>
            <ol class="order">{seq.map((n, idx) => (
              <li class={idx >= 21 ? "legacy" : ""}>
                <span>{idx < 21 ? `Nv ${idx + 10}` : "Legacy"}</span>
                <span style="display:flex;gap:8px;align-items:center"><Icon name={sham.byName[n]?.icon} size={20} label={n} /> {n}</span>
              </li>
            ))}</ol>
          </div>
        )}
        {s.extra === "gear" && <div class="gextra"><GearTable cls="shaman" title="Equipo de nivel 30 · Mejora PvP" /><p class="note" style="margin-top:6px">Prioridad: el arma de dos manos más grande, luego Aguante, Fuerza, Intelecto (Mental Dexterity lo convierte en poder de ataque) y Agilidad.</p></div>}
        {s.extra === "matchups" && (
          <div class="gextra"><div class="eyebrow">Cómo jugar cada cruce con tu Chamán</div>
            <div class="tablewrap" style="margin-top:6px"><table class="wide"><thead><tr><th>Rival</th><th>Plan</th></tr></thead><tbody>
              {MATCHUPS.map((r) => <tr><td><b>{r[0]}</b></td><td>{r[1]}</td></tr>)}
            </tbody></table></div>
          </div>
        )}
      </section>
    ))}
  </div>

  <script define:vars={{ allKeys }}>
    window.__TFO_KEYS = allKeys;
  </script>
  <script>
    const $ = (id: string) => document.getElementById(id)!;
    const KEY = "tfo-guide";
    let done: Record<string, boolean> = {};
    try { done = JSON.parse(localStorage.getItem(KEY) || "{}"); } catch {}
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(done)); } catch {} };
    const boxes = [...document.querySelectorAll<HTMLInputElement>("input[data-k]")];
    let role = "main";
    try { role = localStorage.getItem("tfo-role") || "main"; } catch {}
    let level = 1;
    try { level = +(localStorage.getItem("tfo-level") || 1) || 1; } catch {}

    function paint() {
      boxes.forEach((b) => { b.checked = !!done[b.dataset.k!]; b.closest("li")!.classList.toggle("done", b.checked); });
      // checklist
      let total = 0, n = 0;
      document.querySelectorAll<HTMLElement>(".gsec").forEach((sec) => {
        const bs = [...sec.querySelectorAll<HTMLInputElement>("input[data-k]")];
        const d = bs.filter((b) => b.checked).length;
        total += bs.length; n += d;
        const id = sec.id.slice(2);
        const gc = sec.querySelector<HTMLElement>("[data-gc]")!;
        gc.textContent = `${d}/${bs.length}`; gc.classList.toggle("full", d === bs.length);
        document.querySelector(`.tocitem[data-sec="${id}"]`)?.classList.toggle("full", d === bs.length);
      });
      // ruta del personaje elegido
      let nextOpen = false;
      document.querySelectorAll<HTMLElement>(".rsecs").forEach((wrap) => {
        const active = wrap.dataset.route === role;
        wrap.hidden = !active;
        wrap.querySelectorAll<HTMLDetailsElement>(".rsec").forEach((sec) => {
          const bs = [...sec.querySelectorAll<HTMLInputElement>("input[data-k]")];
          const d = bs.filter((b) => b.checked).length;
          if (active) { total += bs.length; n += d; }
          const from = +sec.dataset.from!, to = +sec.dataset.to!;
          const complete = d === bs.length;
          const state = complete ? "done" : to < level ? "late" : from <= level ? "now" : "next";
          sec.className = `rsec ${state}`;
          const tag = sec.querySelector<HTMLElement>("[data-tag]")!;
          tag.textContent = complete ? "Hecho" : state === "late" ? `Atrasado · ${d}/${bs.length}` : state === "now" ? `Ahora · ${d}/${bs.length}` : `${d}/${bs.length}`;
          if (!sec.dataset.touched) {
            let open = state === "now" || state === "late";
            if (state === "next" && !nextOpen) { open = true; nextOpen = true; }
            sec.open = open;
          }
        });
      });
      $("gProgNum").textContent = `${n}/${total}`;
      const pct = total ? Math.round((n / total) * 100) : 0;
      $("gProgFill").style.width = pct + "%";
      $("gProgBar").setAttribute("aria-valuenow", String(pct));
      document.querySelectorAll<HTMLButtonElement>("[data-role]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.role === role)));
      ($("lvl") as HTMLInputElement).value = String(level);
      ($("lvlRange") as HTMLInputElement).value = String(level);
    }

    document.addEventListener("change", (e) => {
      const t = e.target as HTMLInputElement;
      if (!t.dataset?.k) return;
      done[t.dataset.k] = t.checked; save(); paint();
    });
    document.querySelectorAll<HTMLDetailsElement>(".rsec").forEach((d) => d.querySelector("summary")!.addEventListener("click", () => { d.dataset.touched = "1"; }));
    document.querySelectorAll<HTMLButtonElement>("[data-role]").forEach((b) => b.addEventListener("click", () => {
      role = b.dataset.role!; try { localStorage.setItem("tfo-role", role); } catch {}
      document.querySelectorAll<HTMLElement>(".rsec").forEach((d) => delete d.dataset.touched); paint();
    }));
    const setLevel = (v: number) => {
      level = Math.min(30, Math.max(1, v || 1)); try { localStorage.setItem("tfo-level", String(level)); } catch {}
      document.querySelectorAll<HTMLElement>(".rsec").forEach((d) => delete d.dataset.touched); paint();
    };
    $("lvl").addEventListener("change", (e) => setLevel(+(e.target as HTMLInputElement).value));
    $("lvlRange").addEventListener("input", (e) => setLevel(+(e.target as HTMLInputElement).value));

    function importCode() {
      const raw = (($("gImport") as HTMLInputElement).value || "").trim();
      const msg = $("gImportMsg");
      if (!raw.startsWith("TFO1")) { msg.innerHTML = '<span style="color:var(--bad)">Ese código no es del addon. Tiene que empezar por TFO1.</span>'; return; }
      const parts = Object.fromEntries(raw.split(";").slice(1).map((p) => { const i = p.indexOf("="); return [p.slice(0, i), p.slice(i + 1)]; }));
      const valid = new Set((window as any).__TFO_KEYS as string[]);
      let n = 0;
      (parts.k || "").split(",").filter(Boolean).forEach((k: string) => { if (valid.has(k) && !done[k]) { done[k] = true; n++; } });
      save();
      if (parts.lv && +parts.lv > 0) { level = +parts.lv; try { localStorage.setItem("tfo-level", String(level)); } catch {} }
      document.querySelectorAll<HTMLElement>(".rsec").forEach((d) => delete d.dataset.touched);
      paint();
      msg.innerHTML = `Importado: <b>${n}</b> casillas nuevas. Nivel ${parts.lv || "?"} · Peletería ${parts.lw || "?"} · Ingeniería ${parts.en || "?"} · Legacy estimado ${parts.lg || "?"}/10 · talentos de la build ${parts.tp || "?"}.`;
      ($("gImport") as HTMLInputElement).value = "";
    }
    $("gImportBtn").addEventListener("click", importCode);
    $("gImport").addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Enter") importCode(); });
    $("gReset").addEventListener("click", () => { $("gResetConfirm").hidden = false; });
    $("gResetNo").addEventListener("click", () => { $("gResetConfirm").hidden = true; });
    $("gResetYes").addEventListener("click", () => { done = {}; save(); $("gResetConfirm").hidden = true; paint(); });
    paint();
  </script>
</Base>
