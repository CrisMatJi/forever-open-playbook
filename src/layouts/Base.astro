---
import "../styles/base.css";
import "../styles/site.css";
import Icon from "../components/Icon.astro";
import { url, MISC_ICON } from "../lib/wow.js";
interface Props { title: string; description?: string; active?: string }
const { title, description = "Guía de fans para The Forever Open: tier list, builds a nivel 30, Legacy y la ruta de speedrun del Chamán Orco.", active = "" } = Astro.props;
const NAV = [
  ["", "Inicio", "duel"], ["guia", "Mi guía", "guide"], ["gameplay", "Mi gameplay", "gameplay"], ["tier", "Tier list", "tier"], ["sacerdote", "Contra Sacerdote", "priest"],
  ["builds", "Builds a 30", "builds"], ["legacy", "Legacy", "legacy"], ["reglas", "Reglas", "rules"], ["addon", "Addon", "addon"],
];
const full = title === "Forever Open Playbook" ? title : `${title} · Forever Open Playbook`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#0c0a08" />
  <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://wow.zamimg.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Marcellus+SC&family=Alegreya+Sans:wght@400;500;700&display=swap" />
  <script is:inline>const whTooltips = { colorLinks: false, iconizeLinks: false, renameLinks: false };</script>
  <script is:inline src="https://wow.zamimg.com/js/tooltips.js" defer></script>
</head>
<body>
  <a class="skip" href="#main">Saltar al contenido</a>
  <header class="topbar">
    <div class="topbar-in">
      <a class="brand" href={url("")}>
        <Icon name="spell_nature_bloodlust" size={30} label="Forever Open" fallback="FO" />
        <span><b>Forever Open</b><small>Playbook</small></span>
      </a>
      <nav class="mainnav" aria-label="Secciones">
        {NAV.map(([p, label, ic]) => (
          <a href={url(p)} aria-current={active === p ? "page" : undefined}>
            <Icon name={MISC_ICON[ic]} size={20} fallback="" />
            <span>{label}</span>
          </a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap foot-in">
      <p>Guía de fans, sin relación con Blizzard Entertainment ni con la organización de The Forever Open. World of Warcraft y sus iconos son marcas de Blizzard Entertainment; los iconos se cargan desde el CDN de Wowhead.</p>
      <p>Datos de la beta de WoW Forever: lo marcado como <span class="verify">verificar</span> aún no se ha podido comprobar en el juego.</p>
    </div>
  </footer>
</body>
</html>
