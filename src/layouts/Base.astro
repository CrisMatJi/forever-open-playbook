---
import "../styles/base.css";
import "../styles/site.css";
import Icon from "../components/Icon.astro";
import { url, MISC_ICON } from "../lib/wow.js";
interface Props { title: string; description?: string; active?: string }
const { title, description = "Guía de leveo de WoW Forever para la Alianza: clases, razas, talentos por nivel, equipo, mazmorras y duelos.", active = "" } = Astro.props;
const NAV = [
  ["", "Inicio", "home"], ["elegir", "Elegir clase", "choose"], ["clases", "Clases", "classes"],
  ["leveo", "Leveo", "level"], ["mazmorras", "Mazmorras", "dungeon"], ["duelos", "Duelos", "pvp"],
];
const full = title === "Forever Playbook" ? title : `${title} · Forever Playbook`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#0c0a08" />
  <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://wow.zamimg.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Marcellus+SC&family=Alegreya+Sans:wght@400;500;700&display=swap" />
  <script is:inline>const whTooltips = { colorLinks: false, iconizeLinks: false, renameLinks: false };</script>
  <script is:inline src="https://wow.zamimg.com/js/tooltips.js" defer></script>
</head>
<body>
  <a class="skip" href="#main">Saltar al contenido</a>
  <header class="topbar">
    <div class="topbar-in">
      <a class="brand" href={url("")}>
        <Icon name="spell_holy_divineintervention" size={30} label="Forever Playbook" fallback="FP" />
        <span><b>Forever</b><small>Playbook · Alianza</small></span>
      </a>
      <nav class="mainnav" aria-label="Secciones">
        {NAV.map(([p, label, ic]) => (
          <a href={url(p)} aria-current={active === p ? "page" : undefined}>
            <Icon name={MISC_ICON[ic]} size={20} fallback="" />
            <span>{label}</span>
          </a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap foot-in">
      <p>Guía de fans, sin relación con Blizzard Entertainment. World of Warcraft y sus iconos son marcas de Blizzard Entertainment; los iconos y fichas de objetos se cargan desde Wowhead.</p>
      <p>Datos de la beta de WoW Forever. Lo marcado como <span class="verify">sin confirmar</span> puede cambiar en el lanzamiento del 4 de noviembre.</p>
    </div>
  </footer>
</body>
</html>
